# shell-remote agent 运行配置
#
# 安装位置：/etc/shell-remote/agent.env
# 权限要求：0600 root:root（含固定鉴权 key）
# 生效方式：systemctl restart shell-remote-agent
#
# ⚠️ 本文件就是「远端终端环境」的事实来源。
#    v0.53.1 起 agent 不再注入 LANG/LC_*，而是把自身环境原样传给远端终端
#    （只额外注入 TERM=xterm-256color、COLORTERM=truecolor）。
#    因此这里设的每个变量远端 `env` 都能看到；没设的则取 systemd 给服务的默认值。
#
# 语法：KEY=value，# 开头为注释。systemd 的 EnvironmentFile 不做 shell 展开，
#       值里写 $HOME 之类不会被替换；不要用 export。

# ── 必填 ──────────────────────────────────────────────────────────────

# Relay 地址。仅 http:// 或 https://（内部按 http→ws / https→wss 做视频上行）
SR_RELAY_URL=https://sshx.zztweb.top

# 固定会话 ID：5-20 位 ASCII 字母数字 [A-Za-z0-9]，管理后台据此区分设备。
# 重复注册不会报冲突：relay 会顶替旧会话、旧 token 失效（newest wins）。
SR_SESSION_ID=__SR_SESSION_ID__

# 固定鉴权 key：直接作为 rw token，重启后不变，浏览器书签可长期复用。
# 留空则每次注册随机生成临时 token（重启即失效）。
SR_KEY=__SR_KEY__

# token 类型：rw | ro | both
# both 会额外生成一个随机 ro token，每次重启都变；需要 ro token 长期稳定时不要用 both。
SR_TOKEN_TYPE=rw

# 远端终端使用哪个 shell（如 /bin/bash、/usr/bin/zsh、/bin/sh）
SR_SHELL=/bin/bash

# 文件管理器默认根目录，同时是远端终端的初始 cwd
SR_ROOT=__SR_ROOT__

# ── 可选 ──────────────────────────────────────────────────────────────

# 额外命令行参数，空格分隔；留空 = 不追加任何参数。
# 例：--relay-insecure    连自签证书 relay 时必填（relay 默认自签 TLS，
#                         不信任则 register 握手直接失败）
SR_EXTRA_ARGS=

# 日志级别（tracing 的 EnvFilter）。
# 默认输出到 stderr → journald：journalctl -u shell-remote-agent -f
# 若另设 SR_LOG_DIR=<目录>，业务日志改为写该目录下按小时滚动的文件
# （此时 journald 里不再有业务日志，只保留启动/退出记录）。
RUST_LOG=info

# 远端终端的 PATH。systemd 给服务的默认 PATH 很短
# （/usr/local/sbin:/usr/local/bin:/usr/bin），不含 /sbin、/usr/sbin、~/.local/bin。
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# 远端终端的 locale —— 默认不设，直接继承目标机自身的 locale。
# systemd 会把目标机的 /etc/locale.conf（或 /etc/default/locale）里的 LANG/LC_*
# 传给服务，再经 agent 原样透传到远端终端。
# 实测：目标机只有 C / C.UTF-8 / POSIX 时，服务与远端终端拿到 LANG=C.UTF-8，无告警。
#
# 只有需要覆盖目标机设置时才取消注释。
# ⚠️ 必须用目标机上真实存在的 locale（`locale -a` 确认）：设一个不存在的 UTF-8
#    locale，会让依赖 locale 的交互式程序每次启动都告警，甚至直接崩
#    （静态 glibc 的 bash 会 SIGSEGV，网页端只看到一个空白终端）。
#LANG=C.UTF-8
#LC_ALL=C.UTF-8

TZ=Asia/Shanghai
